{
  "name": "backend",
  "version": "1.0.0",
  "description": "Production-grade persistent Email Scheduler service using Express, TypeScript, MongoDB, BullMQ, Redis, and Nodemailer (Ethereal)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "server": "nodemon --exec tsx server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bullmq": "^6.7.10",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "ioredis": "^6.1.0",
    "mongoose": "^9.13.1",
    "nodemailer": "^10.6.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "nodemon": "^3.1.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
